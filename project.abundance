      ],
      "interpreterVersion": 1,
      "code": "// face.asPlane\nfunction run(face: Assembly, u: number = 0.5, v: number = 0.5, xPos: number[]) {\n  let xposOverride = undefined;\n  if (xPos.length == 3 && new replicad.Vector(xPos as [number, number, number]).Length > 0) {\n    xposOverride = new replicad.Vector(xPos as [number, number, number])\n  }\n\n  const normUV = (uV: number, min: number, max: number) => {\n    return min + (max - min) * uV\n  }\n  return face.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Face) {\n      leaf.plane = replicad.makePlaneFromFace(leaf.geometry, [u, v])\n      if (xposOverride) {\n        const projXDir = xposOverride.projectToPlane(leaf.plane)\n        if (projXDir.Length == 0) {\n          throw new Error(`xPos direction (${xposOverride.normalize()}) is parallel to z Axis: ${leaf.plane.zDir}.`)\n        }\n        const deg = Math.acos(projXDir.dot(leaf.plane.xDir)) / replicad.DEG2RAD\n        const sign = Math.sign(leaf.plane.zDir.dot(projXDir.cross(leaf.plane.xDir)))\n        leaf.plane = leaf.plane.rotate2DAxes(deg * sign * -1)\n        console.log(`degrees different: ${deg} sign: ${sign}.`)\n      }\n      leaf.geometry = replicad.drawRectangle(1, 0.5)\n    }\n    return leaf;\n  })\n}",
      "compiledCode": "\"use strict\";\n// face.asPlane\nfunction run(face, u = 0.5, v = 0.5, xPos) {\n    let xposOverride = undefined;\n    if (xPos.length == 3 && new replicad.Vector(xPos).Length > 0) {\n        xposOverride = new replicad.Vector(xPos);\n    }\n    const normUV = (uV, min, max) => {\n        return min + (max - min) * uV;\n    };\n    return face.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Face) {\n            leaf.plane = replicad.makePlaneFromFace(leaf.geometry, [u, v]);\n            if (xposOverride) {\n                const projXDir = xposOverride.projectToPlane(leaf.plane);\n                if (projXDir.Length == 0) {\n                    throw new Error(`xPos direction (${xposOverride.normalize()}) is parallel to z Axis: ${leaf.plane.zDir}.`);\n                }\n                const deg = Math.acos(projXDir.dot(leaf.plane.xDir)) / replicad.DEG2RAD;\n                const sign = Math.sign(leaf.plane.zDir.dot(projXDir.cross(leaf.plane.xDir)));\n                leaf.plane = leaf.plane.rotate2DAxes(deg * sign * -1);\n                console.log(`degrees different: ${deg} sign: ${sign}.`);\n            }\n            leaf.geometry = replicad.drawRectangle(1, 0.5);\n        }\n        return leaf;\n    });\n}\n"
    },
